{
  "name": "settlementqueue-api-gateway",
  "version": "1.0.0",
  "description": "Production-ready API Gateway for SettlementQueueV5 with GraphQL, REST, WebSocket support",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "npm run lint && npm test",
    "docker:build": "docker build -t settlementqueue-gateway .",
    "docker:run": "docker run -p 3000:3000 settlementqueue-gateway",
    "migrate": "node scripts/migrate-database.js",
    "seed": "node scripts/seed-data.js"
  },
  "dependencies": {
    "fastify": "^4.24.3",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.0.1",
    "@fastify/compress": "^6.4.0",
    "@fastify/caching": "^8.1.0",
    "@fastify/websocket": "^8.3.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/cookie": "^9.2.0",
    "@fastify/redis": "^6.1.1",
    "@fastify/mongodb": "^8.0.0",
    "mercurius": "^13.3.3",
    "graphql": "^16.8.1",
    "graphql-scalars": "^1.22.4",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^0.12.0",
    "joi": "^17.11.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "bcrypt": "^5.1.1",
    "crypto": "^1.0.1",
    "uuid": "^9.0.1",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "compression": "^1.7.4",
    "express-slow-down": "^1.6.0",
    "node-cache": "^5.1.2",
    "ioredis": "^5.3.2",
    "pino": "^8.16.1",
    "pino-pretty": "^10.2.3",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "prometheus-client": "^1.0.0",
    "winston": "^3.11.0",
    "bull": "^4.12.2",
    "pg": "^8.11.3",
    "mongodb": "^6.2.0",
    "ethers": "^6.8.1",
    "web3": "^4.2.2",
    "dotenv": "^16.3.1",
    "config": "^3.3.9"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.53.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "@types/jest": "^29.5.8",
    "mongodb-memory-server": "^9.1.1",
    "redis-memory-server": "^0.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "api-gateway",
    "graphql",
    "rest",
    "websocket",
    "defi",
    "settlement",
    "mev-protection",
    "fastify",
    "microservices"
  ],
  "author": "DEX Security Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/settlement-queue/api-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/settlement-queue/api-gateway/issues"
  },
  "homepage": "https://github.com/settlement-queue/api-gateway#readme"
}