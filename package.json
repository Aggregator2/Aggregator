{
  "name": "hardhat-clean-project",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/hmr-patch.js && npx next dev",
    "dev:full": "./fix-and-start.sh",
    "dev:next": "npx next dev",
    "build": "npx next build",
    "start": "npx next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "compile": "hardhat compile",
    "test": "node scripts/run-tests.js",
    "test:all": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:contracts": "node scripts/run-tests.js contracts",
    "test:e2e": "node scripts/run-tests.js e2e",
    "test:e2e:fixed": "node scripts/run-integration-tests.js",
    "test:infra": "npx jest tests/integration/infrastructure-test.ts --verbose",
    "verify:token-aggregator": "node scripts/verify-token-aggregator.js",
    "verify:stack-overflow": "node scripts/test-stack-overflow-fix.js",
    "verify:startup": "node scripts/verify-startup.js",
    "predev": "node scripts/verify-startup.js",
    "test:coverage": "jest --coverage --coverageReporters=html text lcov",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "coverage:badge": "node scripts/coverage-badge.js",
    "test:comprehensive": "./tests/run-all-tests.sh",
    "test:matching": "jest tests/matching-engine/comprehensive-matching.test.ts --verbose",
    "test:settlement": "jest tests/settlement/comprehensive-settlement.test.ts --verbose",
    "test:hft": "jest --config tests/hft/jest.config.js",
    "test:hft:instant": "jest --config tests/hft/jest.config.js instantFinality.test.ts",
    "test:hft:mev": "jest --config tests/hft/jest.config.js mevProtection.test.ts",
    "test:hft:performance": "jest --config tests/hft/jest.config.js stateChannelPerformance.test.ts",
    "test:hft:rollup": "jest --config tests/hft/jest.config.js optimisticRollup.test.ts",
    "test:performance": "node -r ts-node/register tests/performance/stress-test.ts",
    "test:stress": "node -r ts-node/register tests/performance/stress-test.ts --stress",
    "test:scalability": "node -r ts-node/register tests/performance/stress-test.ts --scalability",
    "test:quote": "node test/quote-generation.test.js",
    "test:quote-performance": "node test/performance/quote-performance.test.js",
    "node": "hardhat node",
    "event-demo": "node utils/eventListenerDemo.js",
    "event-listen": "node utils/escrowEventListener.js",
    "event-listen-health": "node utils/escrowEventListener.js --with-health",
    "event-simulate": "node utils/escrowEventListener.js --simulate",
    "event-history": "node utils/escrowEventListener.js --history",
    "test-event-listener": "powershell -ExecutionPolicy Bypass -File test-event-listener.ps1",
    "test-integration": "node utils/eventListenerIntegrationTest.js",
    "health-service": "node utils/healthServiceStandalone.js",
    "simulate-events": "hardhat run scripts/simulateEscrowEvents.js --network localhost",
    "docker:build": "docker build -f Dockerfile.listener -t meta-aggregator-listener .",
    "docker:run": "docker run -p 3002:3002 --env-file .env.local meta-aggregator-listener",
    "docker:compose": "docker-compose up",
    "docker:compose-build": "docker-compose up --build",
    "docker:compose-down": "docker-compose down",
    "claude:setup": "powershell -ExecutionPolicy Bypass -File .devcontainer/setup.ps1",
    "claude:analyze": "node .devcontainer/auto-fix.js analyze",
    "claude:fix": "node .devcontainer/auto-fix.js",
    "claude:test": "node .devcontainer/test-api.js",
    "type-check": "tsc --noEmit",
    "check-imports": "node scripts/check-type-imports.js",
    "claude-yolo": "bash /workspace/.devcontainer/yolo-tevm-setup.sh",
    "claude-test": "bash /workspace/scripts/claude-tevm-runner.sh",
    "claude-generate": "claude-code generate-tests --file src/index.ts --contract FixedEscrow",
    "claude-execute": "claude-code execute --function getBestPrice --context tevm",
    "claude-validate": "claude-code validate --memory escrow-memory.json --tool web-search",
    "tevm-test": "jest --config jest.config.js",
    "claude-optimize": "claude-code optimize --file src/index.ts --goal \"minimize gas costs\"",
    "claude-security": "claude-code security-scan --file src/contracts/ --comprehensive"
  },
