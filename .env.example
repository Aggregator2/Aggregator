# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/aggregator_db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# Blockchain RPC URLs
ETHEREUM_RPC=https://eth.llamarpc.com
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
BSC_RPC=https://bsc-dataseed1.binance.org
POLYGON_RPC=https://polygon-rpc.com
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
OPTIMISM_RPC=https://mainnet.optimism.io
FANTOM_RPC=https://rpc.ftm.tools
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Backend Wallet Configuration
BACKEND_PRIVATE_KEY=your_private_key_here
BACKEND_WALLET_ADDRESS=your_wallet_address_here
ESCROW_CONTRACT_ADDRESS=0x...

# Revenue Collection Configuration
# Private key for the wallet that will collect and transfer fees
REVENUE_PRIVATE_KEY=your_revenue_collector_private_key_here
# Wallet address where accumulated revenue will be sent
REVENUE_WALLET=your_secure_revenue_wallet_address_here
# Admin API key for manual revenue operations
ADMIN_API_KEY=your_secure_admin_api_key_here

# API Keys for Enhanced Token Discovery and Quotes

# CoinGecko API (for comprehensive token data across all chains)
# Get from: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_api_key_here

# 1inch API (for multi-chain DEX aggregation)
# Get from: https://portal.1inch.dev/
ONEINCH_API_KEY=your_1inch_api_key_here

# Tron API Key (for TronScan API access)
# Default provided: 5b324f5c-6644-48e7-b492-84285a6c97b8
TRON_API_KEY=5b324f5c-6644-48e7-b492-84285a6c97b8

# Optional: Additional API keys for enhanced functionality
PARASWAP_API_KEY=your_paraswap_api_key_here
JUPITER_API_KEY=your_jupiter_api_key_here

# Supabase (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Slack Webhook (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000