{
  "dashboard": {
    "id": null,
    "title": "SwappiQ Trading Overview",
    "description": "Comprehensive trading metrics and KPIs for SwappiQ Protocol",
    "tags": ["swappiq", "trading", "overview"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s",
    "schemaVersion": 37,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "Trading Volume (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(swappiq_trade_volume_usd[24h]))",
            "legendFormat": "Total Volume",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1000000},
                {"color": "green", "value": 10000000}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "horizontal"
        }
      },
      {
        "id": 2,
        "title": "Active Orders",
        "type": "stat",
        "targets": [
          {
            "expr": "swappiq_active_orders_total",
            "legendFormat": "Active Orders",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1000},
                {"color": "red", "value": 5000}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Trade Count (1h)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(swappiq_trades_total[1h]))",
            "legendFormat": "Trades",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 100},
                {"color": "green", "value": 500}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Active Users",
        "type": "stat",
        "targets": [
          {
            "expr": "swappiq_active_users_1h",
            "legendFormat": "Active Users",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 200}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Trading Volume by Pair",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (trading_pair) (increase(swappiq_trade_volume_usd[1h]))",
            "legendFormat": "{{trading_pair}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 0
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "pieType": "pie",
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        }
      },
      {
        "id": 6,
        "title": "Order Book Depth",
        "type": "bargauge",
        "targets": [
          {
            "expr": "swappiq_orderbook_depth_bids",
            "legendFormat": "Bids - {{trading_pair}}",
            "refId": "A"
          },
          {
            "expr": "swappiq_orderbook_depth_asks",
            "legendFormat": "Asks - {{trading_pair}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 100000},
                {"color": "green", "value": 500000}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 7,
        "title": "Trade Volume Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(swappiq_trade_volume_usd[5m]))",
            "legendFormat": "Volume/min",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 0.2,
              "gradientMode": "opacity"
            }
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "calcs": ["last", "mean", "max"],
            "displayMode": "table",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 8,
        "title": "Order Processing Latency",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(swappiq_order_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(swappiq_order_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(swappiq_order_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
      },
      {
        "id": 9,
        "title": "Settlement Status",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(swappiq_settlements_total{status=\"success\"}[5m]))",
            "legendFormat": "Successful",
            "refId": "A"
          },
          {
            "expr": "sum(rate(swappiq_settlements_total{status=\"failed\"}[5m]))",
            "legendFormat": "Failed",
            "refId": "B"
          },
          {
            "expr": "swappiq_pending_settlements",
            "legendFormat": "Pending",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}
      },
      {
        "id": 10,
        "title": "Top Trading Pairs by Volume",
        "type": "table",
        "targets": [
          {
            "expr": "sort_desc(sum by (trading_pair) (increase(swappiq_trade_volume_usd[1h])))",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 0,
            "custom": {
              "displayMode": "color-background",
              "align": "auto"
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "trading_pair"},
              "properties": [
                {"id": "custom.width", "value": 150}
              ]
            }
          ]
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
        "options": {
          "showHeader": true
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "trading_pair": "Trading Pair",
                "Value": "Volume (1h)"
              }
            }
          }
        ]
      },
      {
        "id": 11,
        "title": "Fee Revenue",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(swappiq_fee_revenue_usd[5m]))",
            "legendFormat": "Fee Revenue/min",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 0.3,
              "gradientMode": "opacity"
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28}
      },
      {
        "id": 12,
        "title": "System Health",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=~\"swappiq-.*\"}",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "mappings": [
              {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "UP", "color": "green"}}, "type": "value"}
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "horizontal"
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "trading_pair",
          "type": "query",
          "query": "label_values(swappiq_trades_total, trading_pair)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "options": [],
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          }
        },
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(up{job=~\"swappiq-.*\"}, instance)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "options": [],
          "current": {
            "selected": true,
            "text": "All",
            "value": "$__all"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "increase(swappiq_deployment_events_total[1m])",
          "iconColor": "blue",
          "textFormat": "Deployment: {{version}}"
        },
        {
          "name": "Alerts",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\", job=~\"swappiq-.*\"}",
          "iconColor": "red",
          "textFormat": "Alert: {{alertname}}"
        }
      ]
    }
  }
}