{
  "order": 0,
  "version": 1,
  "index_patterns": ["swappiq-*"],
  "settings": {
    "index": {
      "lifecycle": {
        "name": "swappiq-policy",
        "rollover_alias": "swappiq"
      },
      "codec": "best_compression",
      "routing": {
        "allocation": {
          "require": {
            "data_tier": "data_hot"
          }
        }
      },
      "refresh_interval": "5s",
      "number_of_shards": 3,
      "auto_expand_replicas": "0-1",
      "number_of_replicas": 1,
      "max_result_window": 50000,
      "analysis": {
        "analyzer": {
          "swappiq_analyzer": {
            "type": "custom",
            "tokenizer": "keyword",
            "filter": ["lowercase", "trim"]
          }
        }
      }
    }
  },
  "mappings": {
    "dynamic": "true",
    "dynamic_templates": [
      {
        "message_field": {
          "path_match": "message",
          "match_mapping_type": "string",
          "mapping": {
            "type": "text",
            "analyzer": "standard",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              }
            }
          }
        }
      },
      {
        "string_fields": {
          "match": "*",
          "match_mapping_type": "string",
          "mapping": {
            "type": "text",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              }
            }
          }
        }
      },
      {
        "float_fields": {
          "match": "*",
          "match_mapping_type": "double",
          "mapping": {
            "type": "float"
          }
        }
      },
      {
        "long_fields": {
          "match": "*",
          "match_mapping_type": "long",
          "mapping": {
            "type": "long"
          }
        }
      }
    ],
    "properties": {
      "@timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "@version": {
        "type": "keyword"
      },
      "timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "level": {
        "type": "keyword"
      },
      "message": {
        "type": "text",
        "analyzer": "standard",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 8192
          }
        }
      },
      "service": {
        "type": "keyword"
      },
      "environment": {
        "type": "keyword"
      },
      "hostname": {
        "type": "keyword"
      },
      "type": {
        "type": "keyword"
      },
      "tags": {
        "type": "keyword"
      },
      
      "request_id": {
        "type": "keyword"
      },
      "user_id": {
        "type": "keyword"
      },
      "client_ip": {
        "type": "ip"
      },
      "http_method": {
