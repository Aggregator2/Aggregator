# Example environment configuration file
# Copy this to .env.production, .env.staging, or .env.development

# Environment
NODE_ENV=production

# Application
APP_NAME="Trading Platform"
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://trading_user:your_password@postgres:5432/trading_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_TLS=false

# Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your-super-secret-encryption-key-32-chars
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key-min-32-chars-long

# CORS
CORS_ORIGIN=https://example.com,https://www.example.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# WebSocket
WS_PORT=3001
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000

# External Services
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
LIFI_API_KEY=your-lifi-api-key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=/var/log/trading-platform

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Trading Platform <noreply@example.com>"

# Storage
UPLOAD_DIR=/var/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Features
FEATURE_TRADING=true
FEATURE_STAKING=false
FEATURE_LENDING=false
FEATURE_EXTERNAL_LIQUIDITY=true

# Performance
CLUSTER_ENABLED=true
WORKER_COUNT=0

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=your-backup-bucket

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance"

# Third-party services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key
SENTRY_DSN=https://your-key@sentry.io/project-id

# Development
DEBUG=false
PLAYGROUND_ENABLED=false